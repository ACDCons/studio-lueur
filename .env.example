# Développement local : utiliser la base SQLite stable du dépôt.
DATABASE_URL=file:data/local.sqlite

# L’intégration Turso de Vercel fournit ces deux variables au projet connecté.
# En développement local, elles sont ignorées pour garder la base locale.
# Ne pas copier de valeurs de production dans ce fichier.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Better Auth local. En production, saisir l’URL publique et un secret propre dans Vercel.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
