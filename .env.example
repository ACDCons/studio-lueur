# Départ local : un fichier SQLite, pas de compte ni de clé cloud.
# Le pilote est compatible Turso : en ligne, seules ces valeurs changeront, pas le code.
DATABASE_URL=file:data/local.sqlite
# Bloc 3 local : saisir la clé de session dans .env.local, jamais dans Git.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# En ligne (bonus de l’exercice 3) : adresse libsql://… et jeton Turso, saisis dans Vercel, jamais dans le chat ni Git.
